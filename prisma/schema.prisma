generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  PRODUCTS
  SERVICES
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Links this business-data row to its Supabase Auth identity
  // (auth.users.id, a UUID — kept as plain text since `auth` isn't modeled
  // in this schema). Nullable because rows created before real auth existed
  // get claimed (linked) by email the first time their owner signs up,
  // rather than being recreated — see lib/current-user.ts.
  authUserId String? @unique

  // Collected at signup.
  industry           String?
  marketingConsent   Boolean      @default(false)
  marketingConsentAt DateTime?
  // Drives the Gestion nav: SERVICES hides Stock / Stock produits finis and
  // relabels "Produits" to "Prestations" — see components/gestion/GestionChrome.tsx.
  activityType       ActivityType @default(PRODUCTS)

  subscription Subscription?
  audits       Audit[]

  products     Product[]
  stockItems   StockItem[]
  orders       Order[]
  expenses     Expense[]
  monthlyGoals MonthlyGoal[]

  @@map("users")
}

// A revenue target the user sets for a given month, checked against
// getDashboardData's "CA (livré)" figure — see the Objectif du mois card.
model MonthlyGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month         String // "YYYY-MM"
  targetRevenue Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@map("monthly_goals")
}

enum PlanTier {
  FREE_TRIAL
  STARTER
  PRO
  AGENCY
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   PlanTier           @default(FREE_TRIAL)
  status SubscriptionStatus @default(TRIALING)

  // Boussla is a single-price product with two billing cadences rather than
  // tiers — billingInterval (not `plan`, which predates Boussla and doesn't
  // map to it) is what currentPeriodEnd is actually computed from.
  // priceAmount snapshots what that cadence cost in DT at selection time, so
  // a later price change never rewrites what a past period actually charged.
  billingInterval BillingInterval?
  priceAmount     Float?

  stripeSubscriptionId String? @unique
  stripePriceId        String?

  auditsQuotaPerMonth  Int @default(5)
  auditsUsedThisPeriod Int @default(0)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum AdPlatform {
  META
  GOOGLE
  TIKTOK
  SNAPCHAT
  OTHER
}

enum CampaignObjective {
  SALES
  LEADS
  TRAFFIC
  MESSAGES
  OTHER
}

enum AuditStatus {
  DRAFT
  ANALYZING
  COMPLETED
  FAILED
}

model Audit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform     AdPlatform
  objective    CampaignObjective
  industry     String
  country      String
  currency     String            @default("TND")
  productName  String
  sellingPrice Float
  productCost  Float
  shippingCost Float             @default(0)
  otherCosts   Float             @default(0)

  status    AuditStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  kpis        CampaignKpi?
  creative    CreativeAnalysis?
  landingPage LandingPageAnalysis?
  diagnosis   Diagnosis?

  @@map("audits")
}

model CampaignKpi {
  id      String @id @default(cuid())
  auditId String @unique
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  spend            Float
  impressions      Int
  reach            Int
  clicks           Int
  landingPageViews Int
  addToCart        Int
  checkouts        Int
  purchases        Int
  revenue          Float
  frequency        Float?

  ctr             Float?
  cpc             Float?
  cpm             Float?
  lpViewRate      Float?
  addToCartRate   Float?
  checkoutRate    Float?
  conversionRate  Float?
  cpa             Float?
  roas            Float?
  margin          Float?
  breakEvenRoas   Float?
  estimatedProfit Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaign_kpis")
}

model CreativeAnalysis {
  id      String @id @default(cuid())
  auditId String @unique
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  imageUrl String?
  videoUrl String?
  mainText String?
  headline String?
  cta      String?

  hookScore              Int?
  attentionScore         Int?
  clarityScore           Int?
  productVisibilityScore Int?
  offerScore             Int?
  benefitScore           Int?
  ctaScore               Int?
  readabilityScore       Int?
  socialProofScore       Int?
  differentiationScore   Int?
  visualConsistencyScore Int?
  persuasionScore        Int?

  creativeScore Int?
  strengths     Json?
  weaknesses    Json?
  rawAiResponse Json?

  createdAt DateTime @default(now())

  @@map("creative_analyses")
}

enum MessageMatchStatus {
  MATCH
  PARTIAL_MISMATCH
  MISMATCH
}

model LandingPageAnalysis {
  id      String @id @default(cuid())
  auditId String @unique
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  url           String?
  screenshotUrl String?

  valuePropositionScore    Int?
  offerScore               Int?
  priceClarityScore        Int?
  ctaScore                 Int?
  productPresentationScore Int?
  argumentScore            Int?
  reviewsScore             Int?
  socialProofScore         Int?
  guaranteesScore          Int?
  deliveryScore            Int?
  paymentOptionsScore      Int?
  trustScore               Int?
  mobileUxScore            Int?
  frictionScore            Int?
  purchaseClarityScore     Int?

  landingPageScore Int?

  messageMatchStatus      MessageMatchStatus?
  messageMatchExplanation String?

  rawAiResponse Json?

  createdAt DateTime @default(now())

  @@map("landing_page_analyses")
}

enum ScaleDecision {
  SCALE
  OPTIMIZE
  TEST
  STOP
  INSUFFICIENT_DATA
}

enum ScalingType {
  VERTICAL
  HORIZONTAL
  NOT_APPLICABLE
}

model Diagnosis {
  id      String @id @default(cuid())
  auditId String @unique
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  campaignScore      Int
  creativeScore      Int?
  trafficScore       Int?
  landingPageScore   Int?
  funnelScore        Int?
  profitabilityScore Int?
  stabilityScore     Int?

  mainDiagnosis   String
  decision        ScaleDecision
  confidenceScore Int
  explanation     String

  scalingType ScalingType? @default(NOT_APPLICABLE)
  actionPlan  Json?

  createdAt DateTime @default(now())

  @@map("diagnoses")
}

// ==================== GESTION MODULE ====================
// Migrated from a localStorage prototype (gestion-complete1109.html).

enum OrderStatus {
  IN_PROGRESS
  DELIVERED
  RETURNED
}

enum PaymentStatus {
  PAID
  PENDING
  UNPAID
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  OTHER
}

enum SellUnit {
  PIECE
  KG
  GRAM
  LITRE
}

model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  sellPrice Float
  unitCost  Float
  // sellPrice/unitCost are "per sellUnit" — 25 for a Kg-priced product means
  // 25 DT/kg, not 25 DT for the whole batch. Pièce (the default) is the one
  // unit that needed no explicit callout before this field existed.
  sellUnit  SellUnit @default(PIECE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines        OrderLine[]
  productionBatches ProductionBatch[]

  @@map("products")
}

model StockItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  unit           String @default("unité")
  alertThreshold Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases StockPurchase[]
  usages    StockUsage[]

  @@map("stock_items")
}

model StockPurchase {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  date     DateTime
  quantity Float
  unitCost Float

  createdAt DateTime @default(now())

  @@map("stock_purchases")
}

model StockUsage {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  date     DateTime
  quantity Float

  createdAt DateTime @default(now())

  @@map("stock_usages")
}

model ProductionBatch {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  date     DateTime
  // Float, not Int: a Kg/Gramme/Litre-priced product can produce a
  // fractional batch (1.5 kg of confiture), same reasoning as OrderLine.
  quantity Float

  createdAt DateTime @default(now())

  @@map("production_batches")
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime
  clientName    String?
  status        OrderStatus   @default(IN_PROGRESS)
  paymentStatus PaymentStatus @default(PENDING)
  paymentDate   DateTime?

  // How the order was/will be paid. CHECK in Tunisia is often postdated —
  // checkDueDate lets the dashboard's trésorerie wait for that date instead
  // of counting the cash the moment the order is marked Payé.
  paymentMethod PaymentMethod @default(CASH)
  checkDueDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines OrderLine[]

  @@map("orders")
}

// Order lines snapshot the product's name/price/cost at order time, so a later
// rename or deletion of the Product never rewrites past orders (matches the
// prototype's `nomProduit` / `prixVente` / `coutUnitaire` snapshot behavior).
model OrderLine {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productNameSnapshot String
  // Float, not Int: a Kg/Gramme/Litre-priced product sells in fractional
  // amounts (1.5 kg, 250 g).
  quantity            Float
  sellPriceSnapshot   Float
  unitCostSnapshot    Float
  // Snapshotted alongside the price/cost so a later change to the product's
  // sellUnit never reinterprets what an already-placed order line meant.
  sellUnitSnapshot    SellUnit

  createdAt DateTime @default(now())

  @@map("order_lines")
}

enum ExpenseCategory {
  ADVERTISING
  TRANSPORT
  FIXED_COSTS
  STOCK_PURCHASES
  SUPPLIES_EQUIPMENT
  RESEARCH_DEVELOPMENT
  RENT
  SALARIES_LABOR
  PACKAGING
  BANK_FEES
  // Reserved for genuinely exceptional cases — the UI doesn't default to
  // this anymore now that there's a real category for almost everything.
  OTHER
}

// Submitted from the public login page's feedback form — not tied to a
// User row, since someone locked out or without an account yet may still
// want to reach out.
model Feedback {
  id      String @id @default(cuid())
  email   String
  message String

  createdAt DateTime @default(now())

  @@map("feedback")
}

model Expense {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  description String
  amount      Float
  category    ExpenseCategory @default(OTHER)

  // When set (>= 2), this expense's amount is split evenly across this many
  // consecutive months for the net-profit (accrual) calculation, starting
  // at `date`'s month — matériel/fournitures durables shouldn't hit the
  // month they were bought in all at once. Trésorerie (cash) still counts
  // the full amount in the purchase month regardless: that's when the money
  // actually left the account. Null/1 means "not spread" (today's behavior).
  spreadMonths Int?

  createdAt DateTime @default(now())

  @@map("expenses")
}

// ==================== HOMEPAGE CMS ====================
// Public landing page content, editable from /admin/accueil without a
// developer. Not scoped to a User — this is global site content, not
// per-tenant business data.

enum HomepageBlockType {
  HERO
  ARGUMENTAIRE
  OFFRES
  TEMOIGNAGES
  FAQ // reserved — no editor or public rendering yet
}

model HomepageBlock {
  id     String            @id @default(cuid())
  type   HomepageBlockType
  // Position across ALL blocks (active or not) — see lib/homepage/actions.ts.
  order  Int
  active Boolean           @default(true)
  // Shape depends on `type` — see lib/homepage/types.ts for the per-type
  // TypeScript shape and the defensive parser that reads this back.
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepage_blocks")
}
