# Supabase Postgres connection string.
#
# Use the Supavisor POOLER host (aws-<n>-<region>.pooler.supabase.com) — the direct
# host db.<ref>.supabase.co is IPv6-only. Username is postgres.<project-ref>.
# Percent-encode special characters in the password (@ -> %40, etc.).
#
# Session mode  (port 5432): works for Prisma Migrate + a long-lived server. One URL, simplest.
# Transaction mode (port 6543): for serverless/edge; append ?pgbouncer=true and set a
#   separate directUrl (session mode) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth — project API (Settings -> API in the Supabase dashboard).
# The publishable key is meant to be public (used client-side); it is not
# the same secret as the DB password above.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service-role secret key (Settings -> API -> service_role secret). Server-only:
# never prefix with NEXT_PUBLIC_, never import lib/supabase/admin.ts from a
# Client Component. Used to read/write the private "receipts" Storage bucket
# (expense receipt photos) via signed URLs, bypassing storage RLS the way
# Prisma's own DB role already bypasses table RLS.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Base URL used to build email confirmation / password-reset links
# (Supabase Auth -> emailRedirectTo / resetPasswordForEmail's redirectTo).
# Defaults to http://localhost:3000 if unset. Set this to the real deployed
# origin in production — and add that same URL to Supabase's dashboard under
# Authentication -> URL Configuration -> Redirect URLs, or Supabase will
# silently ignore it and fall back to its own default Site URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local dev only: set to an existing user's email to skip Supabase Auth
# entirely and work as that user (e.g. while rate-limited on real signups).
# Never active in production, and never set this in a committed file.
# DEV_BYPASS_AUTH_EMAIL="you@example.com"
