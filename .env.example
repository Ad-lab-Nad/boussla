# Supabase Postgres connection string.
#
# Use the Supavisor POOLER host (aws-<n>-<region>.pooler.supabase.com) — the direct
# host db.<ref>.supabase.co is IPv6-only. Username is postgres.<project-ref>.
# Percent-encode special characters in the password (@ -> %40, etc.).
#
# Session mode  (port 5432): works for Prisma Migrate + a long-lived server. One URL, simplest.
# Transaction mode (port 6543): for serverless/edge; append ?pgbouncer=true and set a
#   separate directUrl (session mode) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"
